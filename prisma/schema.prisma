generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  emailVerified   DateTime?
  image           String?
  hashedPassword  String?
  role            String    @default("user") // "user" | "admin"
  balanceCents    Int       @default(0)
  stripeCustomerId      String?
  stripeConnectAccountId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  vaultItems      VaultItem[]
  listings        Listing[]
  buyOrders       Order[]   @relation("BuyerOrders")
  sellOrders      Order[]   @relation("SellerOrders")
  submissions     VaultSubmission[]
  watchlist       Watchlist[]
  walletTransactions  WalletTransaction[]
  packRips            PackRip[]
  buybackTransactions BuybackTransaction[] @relation("UserBuybacks")
  revenueShares       RevenueShare[]       @relation("VaulterShares")
  authenticatorReports AuthenticationReport[] @relation("AuthenticatorReports")
  ownershipFrom        OwnershipRecord[]      @relation("OwnershipFrom")
  ownershipTo          OwnershipRecord[]      @relation("OwnershipTo")
  bids                 Bid[]                  @relation("BidderBids")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Sneaker {
  id            String    @id @default(cuid())
  brand         String
  model         String
  colorway      String?
  styleCode     String?
  retailPriceCents Int?
  imageUrl      String?
  releaseDate   DateTime?
  category      String    @default("lifestyle") // "lifestyle" | "basketball" | "running" | "skateboarding"
  createdAt     DateTime  @default(now())

  vaultItems    VaultItem[]
  priceHistory  PriceHistory[]
  watchlist     Watchlist[]
  bids          Bid[]
}

model VaultItem {
  id                   String   @id @default(cuid())
  ownerId              String
  sneakerId            String
  size                 String
  condition            String   // "deadstock" | "vnds" | "excellent" | "good"
  status               String   @default("pending_auth")
  // "pending_auth" | "authenticated" | "vaulted" | "packed" | "listed" | "sold" | "redeemed"
  authenticationStatus String   @default("pending")
  // "pending" | "passed" | "failed"
  askingPriceCents     Int?
  fmvOverrideCents     Int?
  originalVaulterId    String?
  vaultLocation        String?
  imageUrls            String[]
  notes                String?
  vaultedAt            DateTime?
  submissionId         String?
  nfcChipId            String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id])
  sneaker    Sneaker         @relation(fields: [sneakerId], references: [id])
  submission VaultSubmission? @relation(fields: [submissionId], references: [id])
  listings           Listing[]
  orders             Order[]
  packPoolItems      PackPoolItem[]
  buybackTransactions BuybackTransaction[]
  revenueShares       RevenueShare[]
  authReport          AuthenticationReport?
  ownershipHistory    OwnershipRecord[]
  bids                Bid[]
}

model Listing {
  id          String   @id @default(cuid())
  vaultItemId String
  sellerId    String
  priceCents  Int
  status      String   @default("active") // "active" | "sold" | "cancelled"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])
  seller    User      @relation(fields: [sellerId], references: [id])
  orders    Order[]
}

model Order {
  id                    String   @id @default(cuid())
  listingId             String
  buyerId               String
  sellerId              String
  vaultItemId           String
  salePriceCents        Int
  buyerFeeCents         Int
  sellerFeeCents        Int
  platformRevenueCents  Int
  stripeSessionId       String?
  stripePaymentIntentId String?
  status                String   @default("pending")
  // "pending" | "paid" | "completed" | "refunded"
  createdAt             DateTime @default(now())

  listing   Listing   @relation(fields: [listingId], references: [id])
  buyer     User      @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller    User      @relation("SellerOrders", fields: [sellerId], references: [id])
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])
}

model VaultSubmission {
  id             String   @id @default(cuid())
  userId         String
  status         String   @default("label_created")
  // "label_created" | "shipped" | "received" | "authenticating" | "completed" | "rejected"
  trackingNumber String?
  itemsExpected  Int      @default(1)
  itemsReceived  Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  vaultItems VaultItem[]
}

model PriceHistory {
  id         String   @id @default(cuid())
  sneakerId  String
  size       String
  priceCents Int
  source     String   @default("platform") // "platform" | "external"
  recordedAt DateTime @default(now())

  sneaker Sneaker @relation(fields: [sneakerId], references: [id])
}

model Watchlist {
  id               String   @id @default(cuid())
  userId           String
  sneakerId        String
  targetPriceCents Int?
  createdAt        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  sneaker Sneaker @relation(fields: [sneakerId], references: [id])

  @@unique([userId, sneakerId])
}

model WalletTransaction {
  id                    String   @id @default(cuid())
  userId                String
  type                  String   // "deposit" | "withdrawal" | "purchase" | "sale" | "buyback" | "revenue_share" | "refund"
  amountCents           Int      // positive = credit, negative = debit
  balanceAfterCents     Int
  description           String
  stripePaymentIntentId String?
  stripeTransferId      String?
  referenceType         String?  // "pack_rip" | "order" | "buyback" | "redemption"
  referenceId           String?
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Drop {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  description         String?
  imageUrl            String?
  theme               String?
  startsAt            DateTime
  endsAt              DateTime?
  status              String    @default("upcoming") // "upcoming" | "live" | "sold_out" | "ended"
  maxPurchasesPerUser Int       @default(1)
  createdAt           DateTime  @default(now())

  packTiers PackTier[]
}

model PackTier {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  priceCents  Int
  imageUrl    String?
  description String?
  totalSupply Int
  soldCount   Int      @default(0)
  status      String   @default("active") // "active" | "sold_out" | "paused"
  dropId      String?
  createdAt   DateTime @default(now())

  drop      Drop?          @relation(fields: [dropId], references: [id])
  poolItems PackPoolItem[]
  rips      PackRip[]
}

model PackPoolItem {
  id          String    @id @default(cuid())
  packTierId  String
  vaultItemId String
  oddsWeight  Int       @default(1)
  status      String    @default("available") // "available" | "claimed"
  claimedAt   DateTime?

  packTier  PackTier  @relation(fields: [packTierId], references: [id])
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])

  rips PackRip[]

  @@index([packTierId, status])
}

model PackRip {
  id                   String    @id @default(cuid())
  userId               String
  packTierId           String
  packPoolItemId       String?
  priceCents           Int
  platformRevenueCents Int
  status               String    @default("pending") // "pending" | "revealed" | "buyback"
  revealedAt           DateTime?
  createdAt            DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id])
  packTier     PackTier      @relation(fields: [packTierId], references: [id])
  packPoolItem PackPoolItem? @relation(fields: [packPoolItemId], references: [id])

  @@index([userId, createdAt])
}

model BuybackTransaction {
  id                   String   @id @default(cuid())
  userId               String
  vaultItemId          String
  fmvCents             Int
  payoutCents          Int      // 85% of FMV
  platformRevenueCents Int      // 15% spread
  createdAt            DateTime @default(now())

  user      User      @relation("UserBuybacks", fields: [userId], references: [id])
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])

  @@index([userId, createdAt])
}

model AuthenticationReport {
  id                String   @id @default(cuid())
  vaultItemId       String   @unique
  authenticatorId   String?
  aiConfidenceScore Float?
  aiProvider        String?
  overallResult     String   // "passed" | "failed" | "inconclusive"
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vaultItem     VaultItem       @relation(fields: [vaultItemId], references: [id])
  authenticator User?           @relation("AuthenticatorReports", fields: [authenticatorId], references: [id])
  checkpoints   AuthCheckpoint[]
  photos        AuthPhoto[]
}

model AuthCheckpoint {
  id        String @id @default(cuid())
  reportId  String
  name      String
  result    String // "pass" | "fail" | "warning"
  notes     String?
  sortOrder Int

  report AuthenticationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model AuthPhoto {
  id        String   @id @default(cuid())
  reportId  String
  angle     String
  imageUrl  String
  sortOrder Int
  createdAt DateTime @default(now())

  report AuthenticationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model OwnershipRecord {
  id          String   @id @default(cuid())
  vaultItemId String
  fromUserId  String?
  toUserId    String
  eventType   String   // "vault_submission" | "marketplace_sale" | "pack_reveal" | "redemption"
  orderId     String?
  packRipId   String?
  createdAt   DateTime @default(now())

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])
  fromUser  User?     @relation("OwnershipFrom", fields: [fromUserId], references: [id])
  toUser    User      @relation("OwnershipTo", fields: [toUserId], references: [id])

  @@index([vaultItemId, createdAt])
}

model RevenueShare {
  id                 String    @id @default(cuid())
  vaulterId          String
  vaultItemId        String
  sourceType         String    // "pack_rip" | "buyback" | "marketplace_sale"
  sourceId           String
  totalRevenueCents  Int
  shareAmountCents   Int       // 1% of totalRevenueCents
  status             String    @default("pending") // "pending" | "credited"
  creditedAt         DateTime?
  createdAt          DateTime  @default(now())

  vaulter   User      @relation("VaulterShares", fields: [vaulterId], references: [id])
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])

  @@index([vaulterId, status])
  @@index([vaultItemId])
}

model Bid {
  id          String    @id @default(cuid())
  sneakerId   String
  bidderId    String
  size        String
  amountCents Int
  status      String    @default("active") // "active" | "accepted" | "countered" | "declined" | "expired" | "cancelled"
  expiresAt   DateTime
  vaultItemId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sneaker   Sneaker    @relation(fields: [sneakerId], references: [id])
  bidder    User       @relation("BidderBids", fields: [bidderId], references: [id])
  vaultItem VaultItem? @relation(fields: [vaultItemId], references: [id])

  @@index([sneakerId, status])
  @@index([bidderId, createdAt])
}
